---
import Base from "../layouts/Base.astro";
import Cmd from "../components/Cmd.astro";
import HeroOndas from "../components/HeroOndas.astro";
import DemoAsistente from "../components/DemoAsistente.astro";
import VideoExplicativo from "../components/VideoExplicativo.astro";
import { leyes, reforma, anexo8 } from "../lib/datos.mjs";
import { ABACUS, COMANDO } from "../lib/constantes.mjs";
import { grafoPortada } from "../lib/seo.mjs";

const titulo = "leyes-mx: las leyes fiscales y laborales de México en tu asistente de IA, con artículo exacto";
const descripcion = "Tu asistente de IA cita ley, artículo, vigencia y fecha de reforma de la LISR, LIVA, CFF, LFT y sus reglamentos, en lugar de inventarlos. En WhatsApp con Abacus o gratis en tu computadora.";

// Cifras leídas de los datos del repo en cada build; nada se escribe a mano.
const lista = leyes();
const por = (s) => lista.find((l) => l.sigla === s);
const total = lista.reduce((n, l) => n + l.articulos, 0);
const anioVig = [...new Set(lista.map((l) => l.anio))].join(", ");
const anexo = anexo8();
const ref = reforma();
const nombre = { LISR: "Ley del Impuesto sobre la Renta", RLISR: "Reglamento de la Ley del ISR", LIVA: "Ley del Impuesto al Valor Agregado",
  RLIVA: "Reglamento de la Ley del IVA", CFF: "Código Fiscal de la Federación", RCFF: "Reglamento del Código Fiscal de la Federación", LFT: "Ley Federal del Trabajo", LSS: "Ley del Seguro Social",
  RACERF: "Reglamento de la LSS en materia de afiliación, clasificación de empresas, recaudación y fiscalización" };
const fiscal = ["LISR", "RLISR", "LIVA", "RLIVA", "CFF", "RCFF"].map(por).filter(Boolean);
const laboral = ["LFT", "LSS", "RACERF"].map(por).filter(Boolean);
const redondo = Math.floor(total / 100) * 100;
const mx = (n) => n.toLocaleString("es-MX");
---
<Base titulo={titulo} descripcion={descripcion} schema={grafoPortada(Astro.site)}>
  <section class="hero" aria-labelledby="h-hero">
    <HeroOndas />
    <div class="wrap hero-in"><div class="hero-txt">
      <p class="sobre">Gratis · por TodoConta</p>
      <h1 id="h-hero">Las leyes de México en tu asistente de IA.</h1>
      <p class="sub">Con artículo exacto y vigencia real.</p>
      <p class="lead">Para que la IA no invente artículos, no cite normas derogadas y no confunda un proyecto con ley vigente.</p>
      <Cmd cmd={COMANDO} etiqueta={`el comando ${COMANDO}`} grande cursor />
      <p class="nota">Sólo tienes que pegarlo en Claude Desktop (modo Code), Claude Code, Codex o la Terminal. <a href="/docs/instalar">Ver guía</a></p>
    </div></div>
  </section>

  <section class="sec" aria-labelledby="h-video">
    <div class="wrap">
      <div class="sec-cab">
        <p class="etq">En 20 segundos</p>
        <h2 id="h-video">Qué hace leyes-mx y por qué conviene tenerlo.</h2>
      </div>
      <div class="video-solo">
        <VideoExplicativo titulo="leyes-mx en 20 segundos" videoUrl="/video/leyes-mx.mp4" poster="/video/leyes-mx-poster.jpg" leyenda={false} />
      </div>
    </div>
  </section>

  <DemoAsistente />

  <section class="sec" id="instalar" aria-labelledby="h-usar">
    <div class="wrap">
      <div class="sec-cab">
        <p class="etq">Cómo usarlo</p>
        <h2 id="h-usar">Elige cómo prefieres trabajar.</h2>
      </div>
      <div class="producto">
        <article class="card oscura">
          <p class="opc">Opción A</p>
          <h3>En tu WhatsApp, con Abacus</h3>
          <p>No instalas nada. leyes-mx ya es la base legal de Abacus, el asistente fiscal de TodoConta: le escribes desde el teléfono y responde con ley, artículo y fecha de reforma. Útil en una junta con el cliente o fuera de la oficina.</p>
          <p class="peque-osc">Abacus es de pago. Puedes probarlo 14 días gratis.</p>
          <div class="acciones"><a class="btn btn-primary" href={ABACUS}>Conocer Abacus</a></div>
        </article>
        <article class="card">
          <p class="opc">Opción B</p>
          <h3>En tu computadora, gratis</h3>
          <p>Para quien ya trabaja con Claude Desktop, Claude Code o Codex en contratos, dictámenes o papeles de trabajo. Copia esta instrucción:</p>
          <Cmd cmd={COMANDO} etiqueta={`el comando ${COMANDO}`} />
          <p class="peque">Pégala en el modo Code de Claude Desktop o en la Terminal. En el chat normal no funciona, porque ahí se ejecuta en un equipo en la nube y no en tu computadora. Detecta tus asistentes y los conecta. Si te falta algún programa, tu asistente te ayuda a instalarlo.</p>
          <div class="acciones"><a class="btn btn-line" href="/docs/instalar">Ver la guía paso a paso</a></div>
        </article>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="h-incluye">
    <div class="wrap">
      <div class="sec-cab">
        <p class="etq">Qué incluye</p>
        <h2 id="h-incluye">Más de {mx(redondo)} artículos con vigencia {anioVig}.</h2>
      </div>
      <div class="listado">
        <div>
          <h3 class="grupo">Materia fiscal</h3>
          <ul class="leyes-l">
            {fiscal.map((l) => <li><span class="sigla">{l.sigla}</span><span class="nom">{nombre[l.sigla] ?? l.nombre}</span><span class="cuenta">{mx(l.articulos)} artículos</span></li>)}
            {anexo && <li><span class="sigla">Anexo 8</span><span class="nom">RMF {anexo.anio}: tarifas de ISR de pagos provisionales, retenciones y cálculo anual</span><span class="cuenta">{anexo.tarifas} tarifas</span></li>}
          </ul>
        </div>
        <div>
          <h3 class="grupo">Materia laboral</h3>
          <ul class="leyes-l">
            {laboral.map((l) => <li><span class="sigla">{l.sigla}</span><span class="nom">{nombre[l.sigla] ?? l.nombre}</span><span class="cuenta">{mx(l.articulos)} artículos</span></li>)}
          </ul>
          {ref && (
            <>
              <h3 class="grupo">Proyectos, siempre aparte</h3>
              <ul class="leyes-l">
                <li class="proy"><span class="sigla">{ref.anio}</span><span class="nom">Paquete Económico y reformas en trámite, rotulados como proyecto</span><span class="cuenta">No es ley vigente</span></li>
              </ul>
            </>
          )}
        </div>
      </div>
      <p class="total"><a href="/docs/leyes">Ver el detalle por ley, año y fecha de reforma</a>.</p>
    </div>
  </section>

  <section class="sec cierre" aria-labelledby="h-gratis">
    <div class="wrap">
      <h2 id="h-gratis">Gratis y sin pagos ocultos.</h2>
      <p>leyes-mx no pide cuenta ni suscripción. Los textos se copian de las publicaciones oficiales y sirven para consultar y fundamentar más rápido; no sustituyen al Diario Oficial de la Federación ni el criterio de un contador o abogado. <a href="/docs/aviso">Aviso legal</a>.</p>
      <div class="acciones"><a class="btn btn-primary" href="#instalar">Instalar gratis</a></div>
    </div>
  </section>
</Base>

<style>
  .sub { margin: 14px 0 0; font-size: clamp(22px, 3vw, 34px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.15; color: var(--soft); }
  .video-solo { max-width: 960px; }
  .opc { margin: 0 0 10px !important; font-family: var(--mono); font-size: 13px !important; color: var(--ghost) !important; }
  .producto .card.oscura .opc { color: #8b94a3 !important; }
  .producto .card .cmd { width: 100%; margin-top: 16px; }
  .producto .card .peque { margin-top: 4px; }
  .peque-osc { font-size: 14.5px !important; color: #8b94a3 !important; }

  .listado { display: grid; gap: 8px 48px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); }
  .listado .grupo { margin: 0 0 6px; }
  .listado ul + .grupo { margin-top: 30px; }
  .leyes-l { list-style: none; margin: 0; padding: 0; }
  .leyes-l li { display: grid; grid-template-columns: 84px 1fr auto; gap: 4px 16px; align-items: baseline; padding: 13px 0; border-top: 1px solid var(--rule); }
  .leyes-l li:last-child { border-bottom: 1px solid var(--rule); }
  .leyes-l .sigla { font-family: var(--mono); font-weight: 700; font-size: 16px; }
  .leyes-l .nom { color: var(--soft); font-size: 16px; line-height: 1.35; }
  .leyes-l .cuenta { font-family: var(--mono); font-size: 13.5px; color: var(--ghost); white-space: nowrap; }
  .leyes-l .proy .cuenta { color: var(--warn); }
  @media (max-width: 520px) { .leyes-l li { grid-template-columns: 72px 1fr; } .leyes-l .cuenta { grid-column: 2; } }

  .cierre .wrap { max-width: 760px; text-align: center; }
  .cierre p { color: var(--soft); margin: 16px auto 0; }
  .cierre .acciones { justify-content: center; margin-top: 26px; }
</style>
